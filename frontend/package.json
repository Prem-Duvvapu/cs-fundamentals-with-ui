{
  "name": "cs-fundamentals-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run diagrams:check",
    "build": "vite build",
    "diagrams:render": "node ../scripts/render-diagrams.mjs",
    "diagrams:check": "node ../scripts/render-diagrams.mjs --check",
    "diagrams:decode": "node ../scripts/render-diagrams.mjs --check --decode",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:responsive": "node ../scripts/test-responsive-layout.mjs",
    "validate:content": "node ../scripts/validate-content.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "katex": "^0.18.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^23.0.0",
    "mermaid": "^11.4.0",
    "playwright": "^1.63.0",
    "saxes": "^6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
